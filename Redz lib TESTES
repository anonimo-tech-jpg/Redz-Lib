local function ApplyThemeEntry(Val)
    local inst, kind = Val.Instance, Val.Type
    if not inst then return end

    if kind == "Gradient" then
        inst.Color = Theme["Color Hub 1"]
    elseif kind == "Frame" then
        inst.BackgroundColor3 = Theme["Color Hub 2"]
    else
        local prop = GetColor(inst)
        if prop == "" then return end
        if kind == "Stroke" then
            inst[prop] = Theme["Color Stroke"]
        elseif kind == "Theme" or kind == "ScrollBar" then
            inst[prop] = Theme["Color Theme"]
        elseif kind == "Text" then
            inst[prop] = Theme["Color Text"]
        elseif kind == "DarkText" or kind == "SubText" then
            inst[prop] = Theme["Color Dark Text"]
        end
    end
end

local function ApplyThemeToAll()
    for _, Val in ipairs(MyLibrary.Instances) do
        pcall(ApplyThemeEntry, Val)
    end
end

function MyLibrary:GetIcon(index)
    if type(index) ~= "string" or index:find("rbxassetid://") or #index == 0 then
        return index
    end

    local firstMatch = nil
    index = string.lower(index):gsub("lucide", ""):gsub("%-", "")

    for Name, Icon in pairs(self.Icons) do
        Name = Name:gsub("lucide", ""):gsub("%-", "")
        if Name == index then
            return Icon
        elseif not firstMatch and Name:find(index, 1, true) then
            firstMatch = Icon
        end
    end

    return firstMatch or index
end

function MyLibrary:SetThemeColor(key, value)
    local currentTheme = MyLibrary.Themes[MyLibrary.Save.Theme]
    if not currentTheme or currentTheme[key] == nil then
        warn("Chave de cor invalida:", tostring(key))
        return
    end

    if key == "Color Hub 1" and type(value) == "table" then
        if #value >= 3 then
            value = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, value[1]),
                ColorSequenceKeypoint.new(0.50, value[2]),
                ColorSequenceKeypoint.new(1.00, value[3])
            })
        else
            warn("Para 'Color Hub 1' passe uma tabela com 3 Color3.")
            return
        end
    end

    if value == nil then
        MyLibrary.Save.CustomColors[key] = nil
        currentTheme[key] = OriginalThemes[MyLibrary.Save.Theme][key]
    else
        MyLibrary.Save.CustomColors[key] = SerializeThemeValue(value)
        currentTheme[key] = value
    end

    SaveLib()
    Connection:FireConnection("ThemeChanged", MyLibrary.Save.Theme)
    ApplyThemeToAll()
end

