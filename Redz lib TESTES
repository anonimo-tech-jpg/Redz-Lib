    local function BindToggleKey(KeyCode)
        if MyLibrary._ToggleConnection then
            MyLibrary._ToggleConnection:Disconnect()
        end
        MyLibrary._ToggleConnection = Track(UserInputService.InputBegan:Connect(function(Input, GPE)
            if GPE then return end
            if Input.KeyCode == KeyCode then
                Window:Minimize()
            end
        end))
    end

    function Window:SetToggleKey(KeyCode)
        if type(KeyCode) == "string" then
            local ok, key = pcall(function() return Enum.KeyCode[KeyCode] end)
            KeyCode = ok and key or nil
        end

        if typeof(KeyCode) ~= "EnumItem" or KeyCode.EnumType ~= Enum.KeyCode then
            warn("KeyCode invalido. Use uma string ou Enum.KeyCode.")
            return
        end

        MyLibrary.Save.ToggleKey = KeyCode.Name
        SaveLib()
        BindToggleKey(KeyCode)
    end

