local function IsPress(Input)
    return Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch
end

-- Se wait == true, a thread atual espera o fim do tween (com limite de seguranca)
local function CreateTween(Configs)
    local Inst = Configs[1] or Configs.Instance
    local Prop = Configs[2] or Configs.Prop
    local NewVal = Configs[3] or Configs.NewVal
    local Time = Configs[4] or Configs.Time or 0.5
    local TweenWait = Configs[5] or Configs.wait or false

    local ok, Tween = pcall(function()
        return TweenService:Create(Inst, TweenInfo.new(Time, Enum.EasingStyle.Quint), {[Prop] = NewVal})
    end)
    if not ok or not Tween then return end

    Tween:Play()
    if TweenWait then
        local done = false
        local c = Tween.Completed:Connect(function() done = true end)
        local waited = 0
        while not done and waited < Time + 0.3 do
            waited = waited + task.wait()
        end
        c:Disconnect()
    end
    return Tween
end

-- Salva so quando o usuario SOLTA o dragger (funciona em mouse e touch)
local function ConnectSave(Inst, func)
    local pressed = false
    Inst.InputBegan:Connect(function(Input)
        if IsPress(Input) then pressed = true end
    end)
    Track(UserInputService.InputEnded:Connect(function(Input)
        if pressed and IsPress(Input) then
            pressed = false
            task.delay(0.15, func)
        end
    end))
end

-- Drag funcionando em mouse E touch
local function MakeDrag(Inst)
    Inst.Active = true
    pcall(function() Inst.AutoButtonColor = false end)

    local DragStart, StartPos, ActiveInput
    local Armed = false

    -- So arrasta se o proprio objeto foi o clicado (nao um filho Active)
    Inst.MouseButton1Down:Connect(function()
        Armed = true
    end)

    Inst.InputBegan:Connect(function(Input)
        if IsPress(Input) then
            ActiveInput = Input
            DragStart = Input.Position
            StartPos = Inst.Position
            Inst:SetAttribute("Dragged", false)
        end
    end)

    Track(UserInputService.InputChanged:Connect(function(Input)
        if not (ActiveInput and Armed) then return end
        if Input.UserInputType == Enum.UserInputType.MouseMovement
            or (Input.UserInputType == Enum.UserInputType.Touch and Input == ActiveInput) then
            local delta = Input.Position - DragStart
            if delta.Magnitude > 6 then
                Inst:SetAttribute("Dragged", true)
            end
            local newPos = UDim2.new(
                StartPos.X.Scale, StartPos.X.Offset + delta.X / UIScale,
                StartPos.Y.Scale, StartPos.Y.Offset + delta.Y / UIScale
            )
            CreateTween({Inst, "Position", newPos, 0.08})
        end
    end))

    Track(UserInputService.InputEnded:Connect(function(Input)
        if Input == ActiveInput or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            ActiveInput = nil
            Armed = false
        end
    end))

    return Inst
end

-- Arrasto de slider (mouse + touch)
local function BindSlider(Holder, Bar, Icon, ScrollParent, OnRelease)
    local dragging = false
    local ActiveInput

    local function SetFromX(x)
        local width = math.max(Bar.AbsoluteSize.X, 1)
        Icon.Position = UDim2.new(math.clamp((x - Bar.AbsolutePosition.X) / width, 0, 1), 0, 0.5, 0)
    end

    Holder.InputBegan:Connect(function(Input)
        if not IsPress(Input) then return end
        dragging = true
        ActiveInput = Input
        if ScrollParent then ScrollParent.ScrollingEnabled = false end
        CreateTween({Icon, "BackgroundTransparency", 0, 0.3})
        SetFromX(Input.Position.X)
    end)

    Track(UserInputService.InputChanged:Connect(function(Input)
        if not dragging then return end
        if Input.UserInputType == Enum.UserInputType.MouseMovement
            or (Input.UserInputType == Enum.UserInputType.Touch and Input == ActiveInput) then
            SetFromX(Input.Position.X)
        end
    end))

    Track(UserInputService.InputEnded:Connect(function(Input)
        if dragging and (Input == ActiveInput or Input.UserInputType == Enum.UserInputType.MouseButton1) then
            dragging = false
            ActiveInput = nil
            if ScrollParent then ScrollParent.ScrollingEnabled = true end
            CreateTween({Icon, "BackgroundTransparency", 0.2, 0.3})
            if OnRelease then OnRelease() end
        end
    end))
end

