    local cachedBorders, lastBorderRefresh = {}, 0
    local function GetLibBorders()
        if tick() - lastBorderRefresh > 1 then
            lastBorderRefresh = tick()
            cachedBorders = {}
            for _, descendant in ipairs(MainFrame:GetDescendants()) do
                if descendant.Name == "LibBorder" then
                    table.insert(cachedBorders, descendant)
                end
            end
        end
        return cachedBorders
    end

    local function UpdateEffects()
        StopRenderLoop()

        if not EffectsConfig.RGBEnabled and not EffectsConfig.CustomColorEnabled then
            RestoreOriginalColor()
            return
        end

        lastBorderRefresh = 0

        Env.SAGAZ_EffectsConnection = RunService.RenderStepped:Connect(function()
            if not EffectsConfig.RGBEnabled and not EffectsConfig.CustomColorEnabled then
                StopRenderLoop()
                RestoreOriginalColor()
                return
            end

            local time = tick() * EffectsConfig.Speed
            local borders = GetLibBorders()
            local baseTransparency = MyLibrary.Save.StrokeTransparency or 0
            local effectType = EffectsConfig.SelectedEffect
            local custom = EffectsConfig.CustomColor
            local baseHue, baseSat, baseVal = custom:ToHSV()
            local rgb = EffectsConfig.RGBEnabled

            for index, border in ipairs(borders) do
                if border.Parent then
                    local color = Color3.new(1, 1, 1)
                    local transparency = baseTransparency

                    if effectType == "Onda (Wave)" then
                        local wave = math.sin((time * 3) + (index * 0.5)) * 0.5 + 0.5
                        if rgb then
                            color = Color3.fromHSV(((time * 0.2) + (index * 0.08)) % 1, 0.85, 1)
                        else
                            color = Color3.fromHSV(baseHue, baseSat, baseVal * (0.3 + (wave * 0.7)))
                        end

                    elseif effectType == "Pulso (Pulse)" then
                        local pulse = (math.sin(time * 4) + 1) / 2
                        if rgb then
                            color = Color3.fromHSV((time * 0.15) % 1, 0.8, 0.4 + (pulse * 0.6))
                        else
                            color = Color3.fromHSV(baseHue, baseSat, baseVal * (0.3 + (pulse * 0.7)))
                        end

                    elseif effectType == "Respiracao (Breathing)" then
                        local alpha = (math.sin(time * 2.5) + 1) / 2
                        transparency = baseTransparency + (1 - baseTransparency) * (1 - alpha)
                        color = rgb and Color3.fromHSV((time * 0.1) % 1, 0.85, 1) or custom

                    elseif effectType == "Pisca-Pisca (Strobe)" then
                        if (math.floor(time * 6) % 2) == 0 then
                            color = rgb and Color3.fromHSV((time * 0.3) % 1, 1, 1) or custom
                        else
                            transparency = 1
                            color = custom
                        end

                    elseif effectType == "Brilho Alternado (Ping-Pong)" then
                        local pingPong = math.abs(math.sin(time * 2 + (index * 0.3)))
                        if rgb then
                            color = Color3.fromHSV((time * 0.2 + (index * 0.1)) % 1, 0.85, pingPong)
                        else
                            color = Color3.fromHSV(baseHue, baseSat * pingPong, baseVal)
                        end
                    end

                    if border:IsA("UIStroke") then
                        border.Color = color
                        border.Transparency = transparency
                    end
                end
            end
        end)
    end

