        function Tab:AddDropdownPlayer(Cfg2)
            local DName = Cfg2[1] or Cfg2.Name or Cfg2.Title or "..."
            local DDesc = Cfg2.Desc or Cfg2.Description or ""
            local OpDefault = Cfg2[3] or Cfg2.Default or "..."
            local Flag = Cfg2[5] or Cfg2.Flag or false
