    local function BuildSlider(Container, Cfg, Stacked)
        local SName = Cfg[1] or Cfg.Name or Cfg.Title or "Slider!"
        local SDesc = Cfg.Desc or Cfg.Description or ""
        local MinV = Cfg[2] or Cfg.MinValue or Cfg.Min or 10
        local MaxV = Cfg[3] or Cfg.MaxValue or Cfg.Max or 100
        local Increase = Cfg[4] or Cfg.Increase or 1
        local Callback = Funcs:GetCallback(Cfg, 6)
        local Flag = Cfg[7] or Cfg.Flag or false
        local Default = Cfg[5] or Cfg.Default or 25
        if CheckFlag(Flag) then Default = GetFlag(Flag) end
        local Min, Max = MinV / Increase, MaxV / Increase

        local Button, LabelFunc, TitleLabel, SliderHolder, SliderBar, SetValueText

        if Stacked then
            Button = InsertTheme(Create("Frame", Container, {
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = Theme["Color Hub 2"],
                Name = "Option"
            }), "Frame")
            AddTransparency(Button)
            Make("Corner", Button, UDim.new(0, 6))
            ApplyBorder(Button)

            TitleLabel = InsertTheme(Create("TextLabel", Button, {
                Size = UDim2.new(1, -60, 0, 15),
                Position = UDim2.new(0, 10, 0, 5),
                BackgroundTransparency = 1,
                Font = MyLibrary.CurrentFont,
                Text = SName,
                TextColor3 = Theme["Color Text"],
                TextSize = 9,
                TextXAlignment = "Left",
                TextTruncate = "AtEnd"
            }), "Text")

            local ValueLabel = InsertTheme(Create("TextLabel", Button, {
                Size = UDim2.new(0, 40, 0, 15),
                Position = UDim2.new(1, -10, 0, 5),
                AnchorPoint = Vector2.new(1, 0),
                BackgroundTransparency = 1,
                Font = MyLibrary.CurrentFont,
                Text = tostring(Default),
                TextColor3 = Theme["Color Theme"],
                TextSize = 9,
                TextXAlignment = "Right"
            }), "Theme")
            SetValueText = function(text) ValueLabel.Text = text end

            SliderHolder = Create("TextButton", Button, {
                Size = UDim2.new(1, -20, 0, 22),
                Position = UDim2.new(0, 10, 0, 22),
                AutoButtonColor = false,
                Text = "",
                BackgroundTransparency = 1
            })

            SliderBar = InsertTheme(Create("Frame", SliderHolder, {
                BackgroundColor3 = Theme["Color Stroke"],
                Size = UDim2.new(1, 0, 0, 6),
                Position = UDim2.new(0.5, 0, 0.5),
                AnchorPoint = Vector2.new(0.5, 0.5)
            }), "Stroke")
        else
            Button, LabelFunc = ButtonFrame(Container, SName, SDesc, UDim2.new(1, -180))

            SliderHolder = Create("TextButton", Button, {
                Size = UDim2.new(0.45, 0, 1),
                Position = UDim2.new(1),
                AnchorPoint = Vector2.new(1, 0),
                AutoButtonColor = false,
                Text = "",
                BackgroundTransparency = 1
            })

            SliderBar = InsertTheme(Create("Frame", SliderHolder, {
                BackgroundColor3 = Theme["Color Stroke"],
                Size = UDim2.new(1, -20, 0, 6),
                Position = UDim2.new(0.5, 0, 0.5),
                AnchorPoint = Vector2.new(0.5, 0.5)
            }), "Stroke")

            local LabelVal = InsertTheme(Create("TextLabel", SliderHolder, {
                Size = UDim2.new(0, 14, 0, 14),
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(0, 0, 0.5),
                BackgroundTransparency = 1,
                TextColor3 = Theme["Color Text"],
                Font = MyLibrary.CurrentFont,
                TextSize = 12
            }), "Text")

            local UIScaleLocal = Create("UIScale", LabelVal)

            LabelVal:GetPropertyChangedSignal("Text"):Connect(function()
                UIScaleLocal.Scale = 0.3
                CreateTween({UIScaleLocal, "Scale", 1.2, 0.1})
                CreateTween({LabelVal, "Rotation", math.random(-1, 1) * 5, 0.15})
                task.delay(0.15, function()
                    CreateTween({UIScaleLocal, "Scale", 1, 0.2})
                    CreateTween({LabelVal, "Rotation", 0, 0.1})
                end)
            end)

            SetValueText = function(text) LabelVal.Text = text end
        end

        AddTransparency(SliderBar)
        Make("Corner", SliderBar)

        local Indicator = InsertTheme(Create("Frame", SliderBar, {
            BackgroundColor3 = Theme["Color Theme"],
            Size = UDim2.fromScale(0.3, 1),
            BorderSizePixel = 0
        }), "Theme")
        Make("Corner", Indicator)

        local SliderIcon = Create("Frame", SliderBar, {
            Size = UDim2.new(0, 6, 0, 12),
            BackgroundColor3 = Color3.fromRGB(220, 220, 220),
            Position = UDim2.fromScale(0.3, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 0.2
        })
        Make("Corner", SliderIcon)

        local LastValue

        local function UpdateValues()
            Indicator.Size = UDim2.new(SliderIcon.Position.X.Scale, 0, 1, 0)
            local raw = math.floor(SliderIcon.Position.X.Scale * (Max - Min) + Min + 0.5)
            local Number = math.floor(raw * Increase * 10000 + 0.5) / 10000
            if Number == LastValue then return end
            LastValue = Number
            Default = Number
            SetValueText(tostring(Number))
            Funcs:FireCallback(Callback, Number)
        end

        local function SetSlider(NewValue, Instant)
            if type(NewValue) ~= "number" then return end
            local range = MaxV - MinV
            local pos = range ~= 0 and math.clamp((NewValue - MinV) / range, 0, 1) or 0
            SetFlag(Flag, NewValue)
            local target = UDim2.fromScale(pos, 0.5)
            if Instant then
                SliderIcon.Position = target
            else
                CreateTween({SliderIcon, "Position", target, 0.3})
            end
        end

        SliderIcon:GetPropertyChangedSignal("Position"):Connect(UpdateValues)
        BindSlider(SliderHolder, SliderBar, SliderIcon, Container, function()
            SetFlag(Flag, Default)
        end)

        SetSlider(Default, true)
        UpdateValues()

        local Slider = {}
        function Slider:Set(NewVal1, NewVal2)
            if type(NewVal1) == "number" then
                SetSlider(NewVal1)
            elseif type(NewVal1) == "function" then
                table.clear(Callback)
                table.insert(Callback, NewVal1)
            elseif type(NewVal1) == "string" then
                if LabelFunc then
                    LabelFunc:SetTitle(NewVal1)
                    if type(NewVal2) == "string" then LabelFunc:SetDesc(NewVal2) end
                else
                    TitleLabel.Text = NewVal1
                end
            end
        end
        function Slider:Get() return Default end
        function Slider:Callback(...) Funcs:InsertCallback(Callback, ...) end
        function Slider:Visible(...) Funcs:ToggleVisible(Button, ...) end
        function Slider:Destroy() Button:Destroy() end
        return Slider
    end

