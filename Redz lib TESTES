-- Resolve uma fonte pelo nome sem estourar erro se ela nao existir
local function SafeFont(name, fallback)
    local ok, font = pcall(function() return Enum.Font[name] end)
    if ok and font then return font end
    return fallback or Enum.Font.LuckiestGuy
end

local function SafeKeyCode(name, fallback)
    local ok, key = pcall(function() return Enum.KeyCode[name] end)
    if ok and key then return key end
    return fallback or Enum.KeyCode.RightShift
end

