        -- CONVITE (TikTok / Discord)
        ------------------------------------------------------------------
        function Tab:AddDiscordInvite(Cfg2)
            local ITitle = Cfg2.Name or Cfg2.Title or Cfg2[1] or "Minhas Redes"
            local Desc = Cfg2.Description or Cfg2.Desc or ""
            local Logo = Cfg2.Logo or Cfg2[2] or ""
            local TikTokLink = Cfg2["Tik Tok"] or Cfg2.TikTok or Cfg2.TikTokInvite or ""
            local DiscordLink = Cfg2.Discord or Cfg2.Invite or Cfg2[3] or ""

            local InviteHolder = Create("Frame", Container, {
                Size = UDim2.new(1, 0, 0, 130),
                Name = "Option",
                BackgroundTransparency = 1
            })
            Make("Corner", InviteHolder, UDim.new(0, 6))
            ApplyBorder(InviteHolder)

            local FrameHolder = InsertTheme(Create("Frame", InviteHolder, {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundColor3 = Theme["Color Hub 2"],
                ClipsDescendants = true
            }), "Frame")
            AddTransparency(FrameHolder)
            Make("Corner", FrameHolder, UDim.new(0, 6))

            local ImageLabel = Create("ImageLabel", FrameHolder, {
                Size = UDim2.new(1, 0, 0, 85),
                Image = "",
                BackgroundTransparency = 1,
                ScaleType = Enum.ScaleType.Crop
            })
            Make("Corner", ImageLabel, UDim.new(0, 6))

            if Logo ~= "" then
                task.spawn(function()
                    if Logo:find("https://") or Logo:find("http://") then
                        if requestFunc and getAssetFunc and writefile then
                            -- nome de arquivo fixo por link (evita acumular arquivos)
                            local hash = #Logo
                            for i = 1, #Logo do hash = (hash * 31 + Logo:byte(i)) % 1000000007 end
                            local fileName = IMAGES_FOLDER .. "/Invite_" .. hash .. ".png"

                            if not (isfile and isfile(fileName)) then
                                local ok, resp = pcall(requestFunc, {
                                    Url = Logo,
                                    Method = "GET",
                                    Headers = {["User-Agent"] = "Mozilla/5.0"}
                                })
                                if ok and resp and resp.Body then
                                    pcall(writefile, fileName, resp.Body)
                                end
                            end

                            if isfile and isfile(fileName) then
                                ImageLabel.Image = getAssetFunc(fileName)
                            end
                        end
                    else
                        local formatted = Logo
                        if not Logo:find("rbxassetid://") and not Logo:find("rbxasset://") then
                            formatted = "rbxassetid://" .. Logo
                        end
                        ImageLabel.Image = formatted
                    end
                end)
            end

            local BottomBar = InsertTheme(Create("Frame", FrameHolder, {
                Size = UDim2.new(1, 0, 0, 48),
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = Theme["Color Hub 2"]
            }), "Frame")
            Make("Corner", BottomBar, UDim.new(0, 6))
            AddTransparency(BottomBar)

            InsertTheme(Create("TextLabel", BottomBar, {
                Size = UDim2.new(1, -210, 0, 16),
                Position = UDim2.new(0, 10, 0, 6),
                Font = MyLibrary.CurrentFont,
                TextColor3 = Theme["Color Text"],
                TextXAlignment = "Left",
                BackgroundTransparency = 1,
                TextSize = 11,
                Text = ITitle
            }), "Text")

            InsertTheme(Create("TextLabel", BottomBar, {
                Size = UDim2.new(1, -210, 0, 18),
                Position = UDim2.new(0, 10, 0, 24),
                Font = MyLibrary.CurrentFont,
                TextColor3 = Theme["Color Dark Text"],
                TextXAlignment = "Left",
                BackgroundTransparency = 1,
                TextSize = 9,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = Desc
            }), "DarkText")

            local ButtonContainer = Create("Frame", BottomBar, {
                Size = UDim2.new(0, 190, 0, 32),
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -8, 0.5, 0),
                BackgroundTransparency = 1
            })

            Create("UIListLayout", ButtonContainer, {
                FillDirection = Enum.FillDirection.Horizontal,
                HorizontalAlignment = Enum.HorizontalAlignment.Right,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 6)
            })

            local function MakeLinkButton(Label, Color, IconId, Link)
                local Btn = Create("TextButton", ButtonContainer, {
                    Size = UDim2.new(0, 90, 0, 28),
                    Text = "  " .. Label,
                    Font = MyLibrary.CurrentFont,
                    TextSize = 10,
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    BackgroundColor3 = Color
                })
                Make("Corner", Btn, UDim.new(0, 6))

                Create("ImageLabel", Btn, {
                    Size = UDim2.new(0, 14, 0, 14),
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 6, 0.5, 0),
                    Image = IconId,
                    BackgroundTransparency = 1
                })

                local Delay = false
                Btn.Activated:Connect(function()
                    local copy = setclipboard or toclipboard
                    if Link ~= "" and copy then
                        pcall(copy, Link)
                    end
                    if Delay then return end
                    Delay = true
                    Btn.Text = "Copiado!"
                    task.wait(2)
                    Btn.Text = "  " .. Label
                    Delay = false
                end)
            end

            MakeLinkButton("TikTok", Color3.fromRGB(10, 10, 10), "rbxassetid://140658929749855", TikTokLink)
            MakeLinkButton("Discord", Color3.fromRGB(88, 101, 242), "rbxassetid://7552532178", DiscordLink)

            local DiscordInvite = {}
            function DiscordInvite:Destroy() InviteHolder:Destroy() end
            function DiscordInvite:Visible(...) Funcs:ToggleVisible(InviteHolder, ...) end
            return DiscordInvite
        end

        return Tab
    end

    ------------------------------------------------------------------
    -- FINALIZACAO
    ------------------------------------------------------------------
    CloseButton.Activated:Connect(function() Window:CloseBtn() end)
    MinimizeButton.Activated:Connect(function() Window:MinimizeBtn() end)

    -- Aplica as imagens salvas (JSON) ou as do tema
    task.spawn(function()
        task.wait(0.1)
        ProcessAndApplyImage(MyLibrary.HubImageLabel, CurrentImageSettings.HubImage or GetThemeImage("HubImage"), "Hub")
        ProcessAndApplyImage(MyLibrary.MinimizeExternalButton, CurrentImageSettings.MinimizeImage or GetThemeImage("MinimizeImage"), "Minimize")
        ProcessAndApplyImage(MyLibrary.TopbarImageLabel, CurrentImageSettings.TopbarImage or GetThemeImage("TopbarImage"), "Topbar")
    end)

    -- Aplica transparencia global salva
    if (MyLibrary.Save.GlobalTransparency or 0) > 0 then
        MyLibrary:SetGlobalTransparency(MyLibrary.Save.GlobalTransparency)
    end

    -- Aplica cor/transparencia das bordas
    for _, stroke in ipairs(MyLibrary.StrokeInstances) do
        if stroke and stroke.Parent then
            UpdateStroke(stroke)
        end
    end

    return Window
end

return MyLibrary
