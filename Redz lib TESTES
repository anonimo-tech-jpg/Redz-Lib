local function GetFullPath(fileName)
    if type(fileName) ~= "string" then
        return fileName
    end
    if fileName:find("/") or fileName:find("\\") then
        return fileName
    end
    return LibFolder .. "/" .. fileName
end

-- Salva JSON com debounce (evita escrever o arquivo a cada tick de slider)
local PendingSaves = {}
local function SaveJson(FileName, data)
    if not writefile then return end
    local path = GetFullPath(FileName)
    local first = PendingSaves[path] == nil
    PendingSaves[path] = data
    if first then
        task.delay(0.3, function()
            local latest = PendingSaves[path]
            PendingSaves[path] = nil
            pcall(function()
                writefile(path, HttpService:JSONEncode(latest))
            end)
        end)
    end
end

local function SaveLib()
    SaveJson(LIB_JSON, MyLibrary.Save)
end

local function VerifyTheme(Theme)
    return MyLibrary.Themes[Theme] ~= nil
end

local function AddTransparency(instance)
    if not instance or typeof(instance) ~= "Instance" then return end
    if table.find(MyLibrary.TransparencyInstances, instance) then return end
    table.insert(MyLibrary.TransparencyInstances, instance)

    local transparency = MyLibrary.Save.GlobalTransparency or 0
    if instance:IsA("Frame") or instance:IsA("TextButton") or instance:IsA("ImageButton") or instance:IsA("ScrollingFrame") then
        instance.BackgroundTransparency = transparency
    end
end

-- Carrega as configuracoes salvas
local function LoadLibSettings(file)
    local path = GetFullPath(file)
    if not (readfile and isfile and isfile(path)) then return end

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok or type(decoded) ~= "table" then return end

    local S = MyLibrary.Save

    if type(decoded.UISize) == "table" and tonumber(decoded.UISize[1]) and tonumber(decoded.UISize[2]) then
        S.UISize = {tonumber(decoded.UISize[1]), tonumber(decoded.UISize[2])}
    end
    if type(decoded.MinimizePos) == "table" and tonumber(decoded.MinimizePos[1]) and tonumber(decoded.MinimizePos[2]) then
        S.MinimizePos = {tonumber(decoded.MinimizePos[1]), tonumber(decoded.MinimizePos[2])}
    end
    if type(decoded.Theme) == "string" and VerifyTheme(decoded.Theme) then
        S.Theme = decoded.Theme
    end
    if type(decoded.CustomColors) == "table" then
        S.CustomColors = decoded.CustomColors
    end
    if type(decoded.Font) == "string" then
        S.Font = decoded.Font
        MyLibrary.CurrentFont = SafeFont(decoded.Font)
    end
    if decoded.ClickSoundEnabled ~= nil then
        S.ClickSoundEnabled = decoded.ClickSoundEnabled == true
    end

    for _, key in ipairs({"TabSize", "GlobalTransparency", "HubTransparency", "HubImageTransparency", "StrokeTransparency", "ClickSoundVolume"}) do
        local n = tonumber(decoded[key])
        if n then S[key] = n end
    end
    for _, key in ipairs({"ToggleKey", "StrokeColor", "MinimizeStrokeColor", "ClickSoundId", "TopbarImage"}) do
        if type(decoded[key]) == "string" then S[key] = decoded[key] end
    end
end

pcall(LoadLibSettings, LIB_JSON)

