            Size = UDim2.new(0, 8, 0, 18),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 1,
            BorderColor3 = Color3.fromRGB(0, 0, 0),
            ZIndex = 102
        })
        Make("Corner", ValuePointer, UDim.new(0, 3))

        -- Botoes sem tema (mantem a cor propria)
        local OkButton = Create("TextButton", Popup, {
            Size = UDim2.new(0.65, -12, 0, 28),
            Position = UDim2.new(0, 8, 1, -34),
            BackgroundColor3 = StartColor,
            AutoButtonColor = false,
            Text = "Aplicar Cor",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 12,
            Font = Enum.Font.SourceSansBold,
            ZIndex = 101
        })
        Make("Corner", OkButton, UDim.new(0, 6))

        local CancelButton = Create("TextButton", Popup, {
            Size = UDim2.new(0.35, -8, 0, 28),
            Position = UDim2.new(0.65, 2, 1, -34),
            BackgroundColor3 = Color3.fromRGB(180, 50, 50),
            AutoButtonColor = false,
            Text = "Cancelar",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 12,
            Font = Enum.Font.SourceSansBold,
            ZIndex = 101
        })
        Make("Corner", CancelButton, UDim.new(0, 6))

        local currentHue, currentSat, currentVal = 0, 1, 1
        local previewColor = StartColor
        local draggingMap, draggingSlider = false, false
        local inputMapConn, inputEndConn

        local function updatePickerVisuals()
            local pureColor = Color3.fromHSV(currentHue, currentSat, 1)
            ValueGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
                ColorSequenceKeypoint.new(1, pureColor)
            })
            previewColor = Color3.fromHSV(currentHue, currentSat, currentVal)
            OkButton.BackgroundColor3 = previewColor
            local brightness = (previewColor.R * 0.299) + (previewColor.G * 0.587) + (previewColor.B * 0.114)
            OkButton.TextColor3 = (brightness > 0.5) and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(255, 255, 255)
        end

        local function updateMapInput(input)
            local absPos, absSize = ColorMap.AbsolutePosition, ColorMap.AbsoluteSize
            local mouseX = math.clamp(input.Position.X - absPos.X, 0, absSize.X)
            local mouseY = math.clamp(input.Position.Y - absPos.Y, 0, absSize.Y)
            currentHue = mouseX / absSize.X
            currentSat = 1 - (mouseY / absSize.Y)
            MapPointer.Position = UDim2.new(currentHue, 0, 1 - currentSat, 0)
            updatePickerVisuals()
        end

        local function updateSliderInput(input)
            local absPos, absSize = ValueSlider.AbsolutePosition, ValueSlider.AbsoluteSize
            local mouseX = math.clamp(input.Position.X - absPos.X, 0, absSize.X)
            currentVal = mouseX / absSize.X
            ValuePointer.Position = UDim2.new(currentVal, 0, 0.5, 0)
            updatePickerVisuals()
        end

        local function disconnectInputs()
            if inputMapConn then inputMapConn:Disconnect() inputMapConn = nil end
            if inputEndConn then inputEndConn:Disconnect() inputEndConn = nil end
            draggingMap = false
            draggingSlider = false
        end

        local function connectInputs()
            disconnectInputs()
            inputMapConn = Track(UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    if draggingMap then
                        updateMapInput(input)
                    elseif draggingSlider then
                        updateSliderInput(input)
                    end
                end
            end))

            inputEndConn = Track(UserInputService.InputEnded:Connect(function(input)
                if IsPress(input) then
                    draggingMap = false
                    draggingSlider = false
                end
            end))
        end

        ColorMap.InputBegan:Connect(function(input)
            if IsPress(input) then
                draggingMap = true
                updateMapInput(input)
            end
        end)

        ValueSlider.InputBegan:Connect(function(input)
            if IsPress(input) then
                draggingSlider = true
                updateSliderInput(input)
            end
        end)

        local presetColors = {
            Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 255),
            Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 0, 255),
            Color3.fromRGB(255, 128, 0), Color3.fromRGB(128, 0, 255), Color3.fromRGB(0, 200, 100),
            Color3.fromRGB(255, 255, 255), Color3.fromRGB(120, 120, 120), Color3.fromRGB(0, 0, 0)
        }

        local function setFromColor(color)
            currentHue, currentSat, currentVal = color:ToHSV()
            MapPointer.Position = UDim2.new(currentHue, 0, 1 - currentSat, 0)
            ValuePointer.Position = UDim2.new(currentVal, 0, 0.5, 0)
            updatePickerVisuals()
        end

        for _, color in ipairs(presetColors) do
            local pBtn = Create("TextButton", PresetContainer, {
                BackgroundColor3 = color,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 101
            })
            Make("Corner", pBtn, UDim.new(0, 3))
            pBtn.Activated:Connect(function()
                setFromColor(color)
            end)
        end

        local PopupObj = {}

        function PopupObj.Close()
            disconnectInputs()
            Blocker.Visible = false
        end

        function PopupObj.Open(color)
            setFromColor(color or previewColor)
            connectInputs()
            Blocker.Visible = true
        end

        function PopupObj.SetTitle(text)
            PopupTitle.Text = text
        end

        function PopupObj.Destroy()
            disconnectInputs()
            Blocker:Destroy()
        end

        OkButton.Activated:Connect(function()
            local picked = previewColor
            PopupObj.Close()
            OnApply(picked)
        end)
        CancelButton.Activated:Connect(PopupObj.Close)

        updatePickerVisuals()
        return PopupObj
    end

    local function BuildColorPicker(Container, Cfg, Ctx)
        local Stacked = Ctx.Stacked
        local CPName = Cfg[1] or Cfg.Name or Cfg.Title or "Color Picker"
        local CPDesc = Cfg.Desc or Cfg.Description or ""
        local CPCallback = Cfg.Callback or function() end
        local CPDefault = Cfg[2] or Cfg.Default or Color3.fromRGB(255, 255, 255)
        local CPFlag = Cfg.Flag or false

        if CheckFlag(CPFlag) then
            CPDefault = GetFlag(CPFlag) or CPDefault
        end
        if typeof(CPDefault) ~= "Color3" then
            CPDefault = Color3.fromRGB(255, 255, 255)
        end

        local Button, LabelFunc = ButtonFrame(Container, CPName, CPDesc, UDim2.new(1, Stacked and -115 or -125))

        local D = Stacked
            and {area = 105, right = -5, rgbW = 42, h = 14, btn = 16, btnX = 45, hexX = 64, hexW = 40, ts = 7}
            or {area = 115, right = -20, rgbW = 45, h = 16, btn = 18, btnX = 50, hexX = 73, hexW = 50, ts = 8}

        local RightArea = Create("Frame", Button, {
            Size = UDim2.new(0, D.area, 1),
            Position = UDim2.new(1, D.right, 0.5),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundTransparency = 1
        })

        local RGBBox = Create("TextBox", RightArea, {
            Size = UDim2.new(0, D.rgbW, 0, D.h),
            Position = UDim2.new(0, 0, 0.5, -D.h / 2),
            BackgroundColor3 = Color3.fromRGB(20, 20, 25),
            Text = "",
            TextColor3 = Color3.fromRGB(220, 220, 230),
            TextSize = D.ts,
            Font = Enum.Font.GothamSemibold,
            ClearTextOnFocus = false,
            PlaceholderText = "R, G, B",
            PlaceholderColor3 = Color3.fromRGB(100, 100, 115)
        })
        Make("Corner", RGBBox, UDim.new(0, 3))

        local ColorButton = Create("ImageButton", RightArea, {
            Size = UDim2.new(0, D.btn, 0, D.btn),
            Position = UDim2.new(0, D.btnX, 0.5, -D.btn / 2),
            BackgroundColor3 = CPDefault,
            AutoButtonColor = false,
            Image = ""
        })
        Make("Corner", ColorButton, UDim.new(0, 3))

        local HexBox = Create("TextBox", RightArea, {
            Size = UDim2.new(0, D.hexW, 0, D.h),
            Position = UDim2.new(0, D.hexX, 0.5, -D.h / 2),
            BackgroundColor3 = Color3.fromRGB(20, 20, 25),
            Text = "",
            TextColor3 = CPDefault,
            TextSize = D.ts,
            Font = Enum.Font.GothamBold,
            ClearTextOnFocus = false,
            PlaceholderText = "#FFFFFF",
            PlaceholderColor3 = Color3.fromRGB(100, 100, 115)
        })
        Make("Corner", HexBox, UDim.new(0, 3))

        local isUpdating = false

        local function updateMainColor(newColor, skipCallback)
            if isUpdating then return end
            isUpdating = true

            ColorButton.BackgroundColor3 = newColor
            RGBBox.Text = math.round(newColor.R * 255) .. ", " .. math.round(newColor.G * 255) .. ", " .. math.round(newColor.B * 255)
            HexBox.Text = Color3ToHex(newColor)
            HexBox.TextColor3 = newColor
            if CPFlag then SetFlag(CPFlag, newColor) end

            if not skipCallback then
                task.spawn(CPCallback, newColor)
            end

            isUpdating = false
        end

        local Popup = BuildColorPopup(Ctx.PopupFolder, CPName, CPDefault, function(color)
            updateMainColor(color)
        end)

        ColorButton.Activated:Connect(function()
            Popup.Open(ColorButton.BackgroundColor3)
        end)

        RGBBox.FocusLost:Connect(function()
            local r, g, b = RGBBox.Text:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
            if r and g and b then
                updateMainColor(Color3.fromRGB(
                    math.clamp(tonumber(r), 0, 255),
                    math.clamp(tonumber(g), 0, 255),
                    math.clamp(tonumber(b), 0, 255)
                ))
            else
                local cur = ColorButton.BackgroundColor3
                RGBBox.Text = math.round(cur.R * 255) .. ", " .. math.round(cur.G * 255) .. ", " .. math.round(cur.B * 255)
            end
        end)

        HexBox.FocusLost:Connect(function()
            local hexText = HexBox.Text:gsub("#", "")
            if #hexText == 6 and tonumber(hexText, 16) then
                local success, newColor = pcall(Color3.fromHex, hexText)
                if success then
                    updateMainColor(newColor)
                    return
                end
            end
            HexBox.Text = Color3ToHex(ColorButton.BackgroundColor3)
            HexBox.TextColor3 = ColorButton.BackgroundColor3
        end)

        updateMainColor(CPDefault, true)

        local ColorPicker = {}
        function ColorPicker:Set(color, skipCB) updateMainColor(color, skipCB) end
        function ColorPicker:Get() return ColorButton.BackgroundColor3 end
        function ColorPicker:Visible(...) Funcs:ToggleVisible(Button, ...) end
        function ColorPicker:Destroy() Popup.Destroy() Button:Destroy() end
        function ColorPicker:SetTitle(title) LabelFunc:SetTitle(title) Popup.SetTitle(title) end
        function ColorPicker:SetDesc(desc) LabelFunc:SetDesc(desc) end
        function ColorPicker:Callback(func) CPCallback = func end
        return ColorPicker
    end

