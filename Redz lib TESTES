    local function GetThemesList()
        local themes = {}
        if not (isfolder and listfiles and isfolder(ThemesFolder)) then return themes end

        local ok, files = pcall(listfiles, ThemesFolder)
        if ok and files then
            for _, file in ipairs(files) do
                local fileName = file:match("([^/\\]+)%.json$")
                if fileName then
                    table.insert(themes, fileName)
                end
            end
        end
        table.sort(themes)
        return themes
    end

    local function SaveTheme(themeName)
        if not writefile or not themeName or themeName:gsub("%s+", "") == "" then
            return false
        end

        local hub1Color = MyLibrary:GetThemeColor("Color Hub 1")
        local gStart, gMiddle, gEnd = "#FFFFFF", "#FFFFFF", "#FFFFFF"

        if typeof(hub1Color) == "ColorSequence" then
            local kps = hub1Color.Keypoints
            gStart = Color3ToHex(kps[1].Value)
            gMiddle = Color3ToHex(kps[math.ceil(#kps / 2)].Value)
            gEnd = Color3ToHex(kps[#kps].Value)
        elseif typeof(hub1Color) == "Color3" then
            gStart = Color3ToHex(hub1Color)
            gMiddle, gEnd = gStart, gStart
        end

        local themeData = {
            GradientStart = gStart,
            GradientMiddle = gMiddle,
            GradientEnd = gEnd,

            ColorHub2 = Color3ToHex(MyLibrary:GetThemeColor("Color Hub 2")),
            ColorStroke = Color3ToHex(MyLibrary:GetThemeColor("Color Stroke")),
            ColorTheme = Color3ToHex(MyLibrary:GetThemeColor("Color Theme")),
            ColorText = Color3ToHex(MyLibrary:GetThemeColor("Color Text")),
            ColorDarkText = Color3ToHex(MyLibrary:GetThemeColor("Color Dark Text")),

            StrokeColor = MyLibrary:GetStrokeColor(),
            MinimizeStrokeColor = MyLibrary:GetMinimizeStrokeColor(),
            StrokeTransparency = MyLibrary:GetStrokeTransparency(),

            HubImage = MyLibrary:GetHubImage(),
            MinimizeImage = MyLibrary:GetMinimizeImage(),
            TopbarImage = MyLibrary:GetTopbarImage(),

            GlobalTransparency = MyLibrary:GetGlobalTransparency(),
            HubTransparency = MyLibrary:GetHubTransparency(),
            HubImageTransparency = MyLibrary:GetHubImageTransparency(),

            ClickSoundEnabled = MyLibrary:GetClickSoundEnabled(),
            ClickSoundId = MyLibrary:GetClickSoundId(),
            ClickSoundVolume = MyLibrary:GetClickSoundVolume(),

            Font = MyLibrary:GetFont().Name
        }

        local success = pcall(function()
            writefile(ThemesFolder .. "/" .. themeName .. ".json", HttpService:JSONEncode(themeData))
        end)

        if success then
            MyLibrary:Notify({Title = "Tema", Message = "Tema '" .. themeName .. "' salvo!", Duration = 3})
        else
            MyLibrary:Notify({Title = "Tema", Message = "Erro ao salvar o tema!", Duration = 3})
        end
        return success
    end

    local function LoadTheme(themeName)
        if not themeName or themeName == "" or not (isfile and readfile) then return false end

        local path = ThemesFolder .. "/" .. themeName .. ".json"
        if not isfile(path) then return false end

        local success, d = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if not success or type(d) ~= "table" then return false end

        if d.GradientStart and d.GradientMiddle and d.GradientEnd then
            MyLibrary:SetThemeColor("Color Hub 1", {
                HexToColor3(d.GradientStart),
                HexToColor3(d.GradientMiddle),
                HexToColor3(d.GradientEnd)
            })
        end

        local colorKeys = {
            ColorHub2 = "Color Hub 2",
            ColorStroke = "Color Stroke",
            ColorTheme = "Color Theme",
            ColorText = "Color Text",
            ColorDarkText = "Color Dark Text",
        }
        for field, key in pairs(colorKeys) do
            if d[field] then MyLibrary:SetThemeColor(key, HexToColor3(d[field])) end
        end

        if d.StrokeColor then MyLibrary:SetStrokeColor(d.StrokeColor) end
        if d.MinimizeStrokeColor then MyLibrary:SetMinimizeStrokeColor(d.MinimizeStrokeColor) end
        if d.StrokeTransparency then MyLibrary:SetStrokeTransparency(d.StrokeTransparency) end

        if d.HubImage and d.HubImage ~= "" then MyLibrary:SetHubImage(d.HubImage) end
        if d.MinimizeImage and d.MinimizeImage ~= "" then MyLibrary:SetMinimizeImage(d.MinimizeImage) end
        if d.TopbarImage and d.TopbarImage ~= "" then MyLibrary:SetTopbarImage(d.TopbarImage) end

        if d.GlobalTransparency then MyLibrary:SetGlobalTransparency(d.GlobalTransparency) end
        if d.HubTransparency then MyLibrary:SetHubTransparency(d.HubTransparency) end
        if d.HubImageTransparency then MyLibrary:SetHubImageTransparency(d.HubImageTransparency) end

        if d.ClickSoundEnabled ~= nil then MyLibrary:SetClickSoundEnabled(d.ClickSoundEnabled) end
        if d.ClickSoundId then MyLibrary:SetClickSoundId(d.ClickSoundId) end
        if d.ClickSoundVolume then MyLibrary:SetClickSoundVolume(d.ClickSoundVolume) end

        if d.Font then
            MyLibrary:SetFont(tostring(d.Font):gsub("Enum%.Font%.", ""))
        end

        MyLibrary:Notify({Title = "Tema", Message = "Tema '" .. themeName .. "' carregado!", Duration = 3})
        return true
    end

