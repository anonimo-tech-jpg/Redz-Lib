    local function LoadFile()
        local File = Settings.ScriptFile
        if type(File) ~= "string" then return end
        local path = GetFullPath(File)
        if not readfile or not isfile then return end
        local s, r = pcall(isfile, path)
        if s and r then
            local s2, content = pcall(readfile, path)
            if s2 and type(content) == "string" then
                local s3, decoded = pcall(function() return HttpService:JSONDecode(content) end)
                Flags = (s3 and type(decoded) == "table") and decoded or {}
            end
        end
    end
