            }), "Stroke")
            AddTransparency(MiniToggleHolder)
            Make("Corner", MiniToggleHolder, UDim.new(0.5, 0))

            local MiniSlider = Create("Frame", MiniToggleHolder, {
                BackgroundTransparency = 1,
                Size = UDim2.new(0.8, 0, 0.8, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5)
            })

            local MiniToggle = InsertTheme(Create("Frame", MiniSlider, {
                Size = UDim2.new(0, 9, 0, 9),
                Position = UDim2.new(0, 0, 0.5),
                AnchorPoint = Vector2.new(0, 0.5),
                BackgroundColor3 = Theme["Color Theme"],
                BackgroundTransparency = 0.8
            }), "Theme")
            Make("Corner", MiniToggle, UDim.new(0.5, 0))

            local function UpdateToggleUI(val)
                if val then
                    CreateTween({MiniToggle, "Position", UDim2.new(1, 0, 0.5), 0.25})
                    CreateTween({MiniToggle, "BackgroundTransparency", 0, 0.25})
                    CreateTween({MiniToggle, "AnchorPoint", Vector2.new(1, 0.5), 0.25})
                else
                    CreateTween({MiniToggle, "Position", UDim2.new(0, 0, 0.5), 0.25})
                    CreateTween({MiniToggle, "BackgroundTransparency", 0.8, 0.25})
                    CreateTween({MiniToggle, "AnchorPoint", Vector2.new(0, 0.5), 0.25})
