    Connection:FireConnection("ThemeChanged", NewTheme)
    ApplyThemeToAll()

    -- Imagens do tema (so aplica se o tema tiver a chave)
    task.spawn(function()
        local hubImg = GetThemeImage("HubImage")
        local minImg = GetThemeImage("MinimizeImage")
        local topImg = GetThemeImage("TopbarImage")

        if hubImg and hubImg ~= "" then
