local IMAGES_FOLDER = LibFolder .. "/imagens"
local JSON_FILE_PATH = IMAGES_FOLDER .. "/imagens.json"

SafeMakeFolder(IMAGES_FOLDER)

local requestFunc = request or http_request or (syn and syn.request)
local getAssetFunc = getcustomasset or getsynasset

local IMAGE_FILES = {
    Hub = IMAGES_FOLDER .. "/ImageHub.png",
    Topbar = IMAGES_FOLDER .. "/ImageTopbar.png",
    Minimize = IMAGES_FOLDER .. "/ImageMinimize.png",
}

local LastImageLinks = {
    Hub = nil,
    Topbar = nil,
    Minimize = nil,
}

-- kind = "Hub" | "Topbar" | "Minimize"
local function ProcessAndApplyImage(objectTarget, imageInput, kind)
    if not objectTarget then return "" end
    if type(kind) ~= "string" or not IMAGE_FILES[kind] then
        warn("[Images] kind invalido:", tostring(kind))
        return ""
    end

    local isImage = objectTarget:IsA("ImageLabel") or objectTarget:IsA("ImageButton")

    if type(imageInput) ~= "string" or imageInput == "" then
        if isImage then objectTarget.Image = "" end
        return ""
    end

    -- Caso 1: link HTTP
    if imageInput:find("https://") or imageInput:find("http://") then
        if not requestFunc or not getAssetFunc or not writefile then
            warn("[Images] Executor nao suporta request/getcustomasset.")
            return imageInput
        end

        local fileName = IMAGE_FILES[kind]

        -- Mesmo link e arquivo ja existe: usa o cache
        if LastImageLinks[kind] == imageInput and isfile and isfile(fileName) then
            local assetPath = getAssetFunc(fileName)
            if isImage then objectTarget.Image = assetPath end
            return assetPath
        end

        if isfile and isfile(fileName) and delfile then
            pcall(delfile, fileName)
        end

        if isImage then objectTarget.Image = "" end

        local ok, response = pcall(requestFunc, {
            Url = imageInput,
            Method = "GET",
            Headers = {["User-Agent"] = "Mozilla/5.0"}
        })

        if ok and response and response.Body and #response.Body > 0 then
            if not pcall(writefile, fileName, response.Body) then
                warn("[Images] Falha ao salvar arquivo: " .. fileName)
                return imageInput
            end

            LastImageLinks[kind] = imageInput

            local assetPath = getAssetFunc(fileName)
            if isImage then
                objectTarget.Image = ""
                task.wait()
                objectTarget.Image = assetPath
            end
            return assetPath
        else
            warn("[Images] Falha ao baixar imagem: " .. tostring(imageInput))
            return imageInput
        end
    end

    -- Caso 2: rbxassetid:// ou ID puro
    local formattedId = imageInput
    if not imageInput:find("rbxassetid://") and not imageInput:find("rbxasset://") then
        formattedId = "rbxassetid://" .. imageInput
    end

    LastImageLinks[kind] = imageInput
    if isImage then objectTarget.Image = formattedId end
    return formattedId
end

