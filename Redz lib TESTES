    local function BuildDropdown(Container, Cfg, Ctx)
        local Stacked = Ctx.Stacked
        local DName = Cfg[1] or Cfg.Name or Cfg.Title or "Dropdown"
        local DDesc = Cfg.Desc or Cfg.Description or ""
        local DOptions = Cfg[2] or Cfg.Options or {}
        local OpDefault = Cfg[3] or Cfg.Default or {}
        local Flag = Cfg[5] or Cfg.Flag or false
        local MultiSelect = Cfg.MultiSelect or false
        local HasSearch = Cfg.Search or Cfg[6] or false
        local Callback = Funcs:GetCallback(Cfg, 4)

        local DropWidth = Ctx.DropWidth
        local OptionHeight = Stacked and 24 or 40
        local SearchHeight = 26
        local MaxVisible = Stacked and 8 or 7
        local SelH = OptionHeight - 14

        local Button, SelectedFrame, Opener

        if Stacked then
            Button = InsertTheme(Create("Frame", Container, {
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = Theme["Color Hub 2"],
                Name = "Option"
            }), "Frame")
            AddTransparency(Button)
            Make("Corner", Button, UDim.new(0, 6))
            ApplyBorder(Button)

            InsertTheme(Create("TextLabel", Button, {
                Size = UDim2.new(1, -20, 0, 15),
                Position = UDim2.new(0, 10, 0, 5),
                BackgroundTransparency = 1,
                Font = MyLibrary.CurrentFont,
                Text = DName,
                TextColor3 = Theme["Color Text"],
                TextSize = 9,
                TextXAlignment = "Left",
                TextTruncate = "AtEnd"
            }), "Text")

            SelectedFrame = InsertTheme(Create("TextButton", Button, {
                Size = UDim2.new(1, -20, 0, 22),
                Position = UDim2.new(0, 10, 0, 22),
                BackgroundColor3 = Theme["Color Stroke"],
                AutoButtonColor = false,
                Text = ""
            }), "Stroke")
            Opener = SelectedFrame
        else
            Button = ButtonFrame(Container, DName, DDesc, UDim2.new(1, -180))

            SelectedFrame = InsertTheme(Create("Frame", Button, {
                Size = UDim2.new(0, 150, 0, 18),
                Position = UDim2.new(1, -10, 0.5),
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = Theme["Color Stroke"]
            }), "Stroke")
            Opener = Button
        end

        AddTransparency(SelectedFrame)
        Make("Corner", SelectedFrame, UDim.new(0, 4))

        local ActiveLabel = InsertTheme(Create("TextLabel", SelectedFrame, {
            Size = UDim2.new(0.85, 0, 0.85, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = 1,
            Font = MyLibrary.CurrentFont,
            TextScaled = true,
            TextColor3 = Theme["Color Text"],
            Text = "..."
        }), "Text")

        local ARROW_DOWN, ARROW_UP = "rbxassetid://10709791523", "rbxassetid://10709790948"
        local Arrow = Create("ImageLabel", SelectedFrame, {
            Size = UDim2.new(0, 15, 0, 15),
            Position = Stacked and UDim2.new(1, -5, 0.5) or UDim2.new(0, -5, 0.5),
            AnchorPoint = Vector2.new(1, 0.5),
            Image = ARROW_DOWN,
            BackgroundTransparency = 1
        })

        local NoClickFrame = Create("TextButton", Ctx.DropHolder, {
            Name = "AntiClick",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Visible = false,
            Text = ""
        })

        local DropFrame = Create("Frame", NoClickFrame, {
            Size = UDim2.new(0, DropWidth, 0, 0),
            BackgroundTransparency = 0.1,
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            AnchorPoint = Vector2.new(0, 0),
            Name = "DropdownFrame",
            ClipsDescendants = true,
            Active = true
        })
        Make("Corner", DropFrame)
        AddTransparency(DropFrame)
        Make("Stroke", DropFrame)
        Make("Gradient", DropFrame, { Rotation = 60 })

        local SearchTextBox
        if HasSearch then
            local SearchBox = Make("Button", DropFrame, {
                Name = "SearchBox",
                Size = UDim2.new(1, -16, 0, SearchHeight),
                Position = UDim2.new(0, 8, 0, 6),
                AnchorPoint = Vector2.new(0, 0)
            })
            Make("Corner", SearchBox, UDim.new(0, 4))

            SearchTextBox = InsertTheme(Create("TextBox", SearchBox, {
                Size = UDim2.new(1, -10, 1, 0),
                Position = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1,
                Font = MyLibrary.CurrentFont,
                TextSize = 12,
                TextColor3 = Theme["Color Text"],
                PlaceholderText = "Pesquisar...",
                PlaceholderColor3 = Theme["Color Dark Text"],
                Text = "",
                TextXAlignment = "Left"
            }), "Text")
        end

        local ScrollFrame = InsertTheme(Create("ScrollingFrame", DropFrame, {
            ScrollBarImageColor3 = Theme["Color Theme"],
            Size = HasSearch and UDim2.new(1, 0, 1, -(SearchHeight + 12)) or UDim2.new(1, 0, 1, 0),
            Position = HasSearch and UDim2.new(0, 0, 0, SearchHeight + 8) or UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 1.5,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.new(),
            ScrollingDirection = "Y",
            AutomaticCanvasSize = "Y",
            Active = true
        }, {
            Create("UIPadding", {
                PaddingLeft = UDim.new(0, 8),
                PaddingRight = UDim.new(0, 8),
                PaddingTop = UDim.new(0, HasSearch and 4 or 6),
                PaddingBottom = UDim.new(0, 6)
            }),
            Create("UIListLayout", { Padding = UDim.new(0, 4) })
        }), "ScrollBar")

        local ScrollSize, Busy, wasSearching = 5, false, false
        local Options = {}
        local Default = type(OpDefault) ~= "table" and {OpDefault} or OpDefault
        local Selected

        if MultiSelect then
            Selected = {}
            for index, Value in pairs(CheckFlag(Flag) and GetFlag(Flag) or Default) do
                if type(index) == "string" then
                    Selected[index] = Value == true
                elseif type(Value) == "string" then
                    Selected[Value] = true
                end
            end
        else
            Selected = CheckFlag(Flag) and GetFlag(Flag) or Default[1]
        end

        -- Declaradas antes para que os metodos publicos enxerguem
        local AddOption, RemoveOption, AddNewOptions, Select

        local function CallbackSelected()
            SetFlag(Flag, MultiSelect and Selected or tostring(Selected))
            Funcs:FireCallback(Callback, Selected)
        end

        local function UpdateLabel()
            if MultiSelect then
                local list = {}
                for index, Value in pairs(Selected) do
                    if Value then table.insert(list, index) end
                end
                table.sort(list)
                ActiveLabel.Text = #list > 0 and table.concat(list, ", ") or "..."
            else
                ActiveLabel.Text = tostring(Selected or "...")
            end
        end

        local function UpdateSelected()
            for _, v in pairs(Options) do
                local on
                if MultiSelect then on = v.Stats else on = (v.Value == Selected) end
                local nodes = v.nodes
                CreateTween({nodes[2], "BackgroundTransparency", on and 0 or 1, 0.35})
                CreateTween({nodes[2], "Size", on and UDim2.fromOffset(4, SelH) or UDim2.fromOffset(4, 4), 0.35})
                CreateTween({nodes[3], "TextTransparency", on and 0 or 0.4, 0.35})
            end
            UpdateLabel()
        end

        local function GetFrameSize()
            local Extra = HasSearch and (SearchHeight + 12) or 0
            return UDim2.fromOffset(DropWidth, ScrollSize + Extra)
        end

        local function CalculateSize(isSearching)
            if isSearching then return end
            local Count = 0
            for _, v in pairs(Options) do
                if v.nodes and v.nodes[1].Visible then Count = Count + 1 end
            end
            ScrollSize = math.clamp(Count, 0, MaxVisible) * (OptionHeight + 4) + 8
            if NoClickFrame.Visible then
                CreateTween({DropFrame, "Size", GetFrameSize(), 0.2})
            end
        end

        local function CalculatePos()
            DropFrame.AnchorPoint = Vector2.new(0, 0)
            DropFrame.Position = Ctx.Position(SelectedFrame, DropWidth, Cfg)
        end

        local function ScrollToSelected()
            if MultiSelect or not Selected then return end
            for _, opt in pairs(Options) do
                if opt.Value == Selected and opt.nodes and opt.nodes[1] then
                    local btn = opt.nodes[1]
                    task.defer(function()
                        local yPos = btn.AbsolutePosition.Y - ScrollFrame.AbsolutePosition.Y + ScrollFrame.CanvasPosition.Y
                        ScrollFrame.CanvasPosition = Vector2.new(0, math.max(0, yPos - 5))
                    end)
                    break
                end
            end
        end

        Select = function(Option)
            if SearchTextBox and #SearchTextBox.Text > 0 then
                wasSearching = true
            end

            Option.LastCB = tick()
            if MultiSelect then
                Option.Stats = not Option.Stats
                Selected[Option.Name] = Option.Stats
            else
                Selected = Option.Value
            end
            CallbackSelected()
            UpdateSelected()
        end

        AddOption = function(index, Value)
            local Name = tostring(type(index) == "string" and index or Value)
            if Options[Name] then return end

            Options[Name] = {
                index = index,
                Value = Value,
                Name = Name,
                Stats = false,
                LastCB = 0
            }

            if MultiSelect then
                Options[Name].Stats = Selected[Name] == true
                Selected[Name] = Options[Name].Stats
            end

            local OptionButton = Make("Button", ScrollFrame, {
                Name = "Option",
                Size = UDim2.new(1, 0, 0, OptionHeight)
            })
            Make("Corner", OptionButton, UDim.new(0, 5))

            local IsSelected = InsertTheme(Create("Frame", OptionButton, {
                Position = UDim2.new(0, 2, 0.5),
                Size = UDim2.new(0, 4, 0, 4),
                BackgroundColor3 = Theme["Color Theme"],
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0, 0.5)
            }), "Theme")
            Make("Corner", IsSelected, UDim.new(0.5, 0))

            local OptionName = InsertTheme(Create("TextLabel", OptionButton, {
                Size = UDim2.new(1, -20, 1, 0),
                Position = UDim2.new(0, 14, 0.5),
                AnchorPoint = Vector2.new(0, 0.5),
                Text = Name,
                TextColor3 = Theme["Color Text"],
                Font = MyLibrary.CurrentFont,
                TextSize = Stacked and 10 or 13,
                TextXAlignment = "Left",
                BackgroundTransparency = 1,
                TextTransparency = 0.4,
                TextTruncate = "AtEnd"
            }), "Text")

            OptionButton.Activated:Connect(function()
                Select(Options[Name])
            end)
            Options[Name].nodes = {OptionButton, IsSelected, OptionName}
        end

        RemoveOption = function(index, Value)
            local Name = tostring(type(index) == "string" and index or Value)
            local opt = Options[Name]
            if opt then
                if MultiSelect then
                    Selected[Name] = nil
                elseif opt.Value == Selected then
                    Selected = nil
                end
                if opt.nodes and opt.nodes[1] then opt.nodes[1]:Destroy() end
                Options[Name] = nil
            end
        end

        AddNewOptions = function(List, Clear)
            local previous = Selected
            if Clear then
                local names = {}
                for k, v in pairs(Options) do table.insert(names, {k, v.Value}) end
                for _, pair in ipairs(names) do RemoveOption(pair[1], pair[2]) end
            end
            for k, v in pairs(List) do AddOption(k, v) end

            -- mantem a selecao se a opcao ainda existe
            if not MultiSelect and previous ~= nil and Selected == nil then
                for _, opt in pairs(Options) do
                    if opt.Value == previous then Selected = previous end
                end
            end

            CalculateSize(false)
            CallbackSelected()
            UpdateSelected()
        end

        if SearchTextBox then
            SearchTextBox:GetPropertyChangedSignal("Text"):Connect(function()
                local query = string.lower(SearchTextBox.Text)
                for _, item in pairs(Options) do
                    item.nodes[1].Visible = query == "" or string.find(string.lower(item.Name), query, 1, true) ~= nil
                end
                CalculateSize(true)
            end)
        end

        for k, v in pairs(DOptions) do AddOption(k, v) end
        CallbackSelected()
        UpdateSelected()

        local function Close()
            if Busy or not NoClickFrame.Visible then return end
            Busy = true
            Arrow.Image = ARROW_DOWN
            CreateTween({Arrow, "ImageColor3", Color3.fromRGB(255, 255, 255), 0.2})
            CreateTween({DropFrame, "Size", UDim2.new(0, DropWidth, 0, 0), 0.2, true})
            NoClickFrame.Visible = false
            Busy = false
        end

        local function ForceClose()
            NoClickFrame.Visible = false
            DropFrame.Size = UDim2.new(0, DropWidth, 0, 0)
            Arrow.Image = ARROW_DOWN
            Arrow.ImageColor3 = Color3.fromRGB(255, 255, 255)
        end

        local function Open()
            if Busy then return end
            if SearchTextBox then
                SearchTextBox.Text = ""
                for _, item in pairs(Options) do item.nodes[1].Visible = true end
            end
            NoClickFrame.Visible = true
            Arrow.Image = ARROW_UP
            CreateTween({Arrow, "ImageColor3", Theme["Color Theme"], 0.2})
            CalculateSize(false)
            CalculatePos()
            CreateTween({DropFrame, "Size", GetFrameSize(), 0.2})

            if wasSearching then
                ScrollToSelected()
                wasSearching = false
            end
        end

        Opener.Activated:Connect(function()
            if NoClickFrame.Visible then Close() else Open() end
        end)
        NoClickFrame.MouseButton1Down:Connect(Close)
        Ctx.VisibleFrame:GetPropertyChangedSignal("Visible"):Connect(ForceClose)
        SelectedFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            if NoClickFrame.Visible then CalculatePos() end
        end)
        ScrollFrame.ChildAdded:Connect(function() CalculateSize(false) end)
        ScrollFrame.ChildRemoved:Connect(function() CalculateSize(false) end)
        CalculatePos()

        local Dropdown = {}
        function Dropdown:Visible(...) Funcs:ToggleVisible(Button, ...) end
        function Dropdown:Destroy() NoClickFrame:Destroy() Button:Destroy() end
        function Dropdown:Callback(...) Funcs:InsertCallback(Callback, ...) end
        function Dropdown:Get() return Selected end

        function Dropdown:Add(...)
            local NewOptions = {...}
            if type(NewOptions[1]) == "table" then NewOptions = NewOptions[1] end
            for _, Name in ipairs(NewOptions) do AddOption(Name, Name) end
            CalculateSize(false)
        end

        function Dropdown:Remove(Option)
            local found = {}
            for index, Value in pairs(Options) do
                if (type(Option) == "number" and Value.index == Option) or Value.Name == Option then
                    table.insert(found, {Value.index, Value.Value})
                end
            end
            for _, pair in ipairs(found) do RemoveOption(pair[1], pair[2]) end
            UpdateSelected()
            CalculateSize(false)
        end

        function Dropdown:Select(Option)
            for _, Val in pairs(Options) do
                if (type(Option) == "string" and Val.Name == Option) or (type(Option) == "number" and Val.index == Option) then
                    Select(Val)
                    break
                end
            end
        end

        -- Set(tabela, manterAntigas): por padrao substitui as opcoes
        function Dropdown:Set(Val1, Keep)
            if type(Val1) == "table" then
                AddNewOptions(Val1, not Keep)
            elseif type(Val1) == "function" then
                table.clear(Callback)
                table.insert(Callback, Val1)
            elseif type(Val1) == "string" then
                Dropdown:Select(Val1)
            end
        end
        function Dropdown:SetOptions(list) AddNewOptions(list, true) end
        function Dropdown:Refresh(list) AddNewOptions(list, true) end

        return Dropdown
    end

