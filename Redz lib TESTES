local function EvictOldestNotification()
    local oldest = table.remove(ActiveNotifications, 1)
    if oldest and oldest.Close then
        task.spawn(oldest.Close)
    end
end

local function RegisterNotification(Frame, HiddenPos, Duration, CloseButton)
    local closed = false
    local Notification = {}

    function Notification.Close()
        if closed then return end
        closed = true

        local index = table.find(ActiveNotifications, Notification)
        if index then table.remove(ActiveNotifications, index) end

        CreateTween({Frame, "Position", HiddenPos, 0.25, true})
        Frame:Destroy()
    end

    table.insert(ActiveNotifications, Notification)
    CloseButton.Activated:Connect(Notification.Close)
    task.delay(Duration, Notification.Close)

    return Notification
end

