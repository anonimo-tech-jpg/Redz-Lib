            ClickPlayerFrame.Activated:Connect(function()
                ClickToggleActive = not ClickToggleActive
                UpdateToggleUI(ClickToggleActive)
            end)

            local NoClickFrame = Create("TextButton", DropdownHolder, {
                Name = "AntiClick",
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Visible = false,
                Text = ""
            })

            local DropFrame = Create("Frame", NoClickFrame, {
                Size = UDim2.new(0, DROPDOWN_WIDTH, 0, 0),
                BackgroundTransparency = 0.1,
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                AnchorPoint = Vector2.new(0, 0),
                Name = "DropdownFrame",
                ClipsDescendants = true,
                Active = true
            })
            Make("Corner", DropFrame)
            AddTransparency(DropFrame)
            Make("Stroke", DropFrame)
            Make("Gradient", DropFrame, { Rotation = 60 })

            local SearchBox = Make("Button", DropFrame, {
                Name = "SearchBox",
                Size = UDim2.new(1, -16, 0, SEARCH_HEIGHT),
                Position = UDim2.new(0, 8, 0, 6),
                AnchorPoint = Vector2.new(0, 0)
            })
            Make("Corner", SearchBox, UDim.new(0, 4))

            local SearchTextBox = InsertTheme(Create("TextBox", SearchBox, {
                Size = UDim2.new(1, -10, 1, 0),
                Position = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1,
                Font = MyLibrary.CurrentFont,
                TextSize = 12,
                TextColor3 = Theme["Color Text"],
                PlaceholderText = "Pesquisar...",
                PlaceholderColor3 = Theme["Color Dark Text"],
                Text = "",
                TextXAlignment = "Left"
            }), "Text")

            local ScrollFrame = InsertTheme(Create("ScrollingFrame", DropFrame, {
                ScrollBarImageColor3 = Theme["Color Theme"],
                Size = UDim2.new(1, 0, 1, -(SEARCH_HEIGHT + 12)),
                Position = UDim2.new(0, 0, 0, SEARCH_HEIGHT + 8),
                ScrollBarThickness = 1.5,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                CanvasSize = UDim2.new(),
                ScrollingDirection = "Y",
                AutomaticCanvasSize = "Y",
                Active = true
            }, {
                Create("UIPadding", {
                    PaddingLeft = UDim.new(0, 8),
                    PaddingRight = UDim.new(0, 8),
                    PaddingTop = UDim.new(0, 4),
                    PaddingBottom = UDim.new(0, 6)
                }),
                Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
            }), "ScrollBar")

            local ScrollSize, Busy = 5, false
            local Options = {}
            local Selected = CheckFlag(Flag) and GetFlag(Flag) or OpDefault

            local function GetFrameSize()
                return UDim2.fromOffset(DROPDOWN_WIDTH, ScrollSize + SEARCH_HEIGHT + 14)
            end

            local function CalculateSize(isSearching)
                if isSearching then return end
                local Count = 0
                for _, v in pairs(Options) do
                    if v.nodes[1] and v.nodes[1].Visible then Count = Count + 1 end
                end
                ScrollSize = math.clamp(Count, 0, MAX_VISIBLE_OPTS) * (OPTION_HEIGHT + 4) + 8
                if NoClickFrame.Visible then
                    CreateTween({DropFrame, "Size", GetFrameSize(), 0.2})
                end
            end

            local function CalculatePos()
                DropFrame.AnchorPoint = Vector2.new(0, 0)
                DropFrame.Position = RowCtx.Position(SelectedFrame, DROPDOWN_WIDTH, Cfg2)
            end

            local function SendPlayerNotification(plr, titleMessage)
                if not plr then return end
                task.spawn(function()
                    local thumb = ""
                    pcall(function()
                        local content, isReady = Players:GetUserThumbnailAsync(
                            plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                        if isReady then thumb = content end
                    end)

                    MyLibrary:NotifyWithImage({
                        Title = titleMessage,
                        SubTitle = plr.DisplayName,
                        Message = "@" .. plr.Name,
                        Image = thumb,
                        Duration = 4
                    })
                end)
            end

            local function UpdateHeaderAvatar(playerObj)
                if playerObj then
                    task.spawn(function()
                        pcall(function()
                            local content, isReady = Players:GetUserThumbnailAsync(
                                playerObj.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                            if isReady then
                                SelectedPlayerIcon.Image = content
                                SelectedPlayerIcon.Visible = true
                                ActiveLabel.AnchorPoint = Vector2.new(0, 0.5)
                                ActiveLabel.Position = UDim2.new(0, 26, 0.5, 0)
                                ActiveLabel.Size = UDim2.new(1, -45, 0.85, 0)
                                ActiveLabel.TextXAlignment = Enum.TextXAlignment.Left
                            end
                        end)
                    end)
                else
                    SelectedPlayerIcon.Visible = false
                    ActiveLabel.AnchorPoint = Vector2.new(0.5, 0.5)
                    ActiveLabel.Position = UDim2.new(0.5, -8, 0.5, 0)
                    ActiveLabel.Size = UDim2.new(1, -25, 0.85, 0)
                    ActiveLabel.TextXAlignment = Enum.TextXAlignment.Center
                end
            end

            local function CallbackSelected()
                SetFlag(Flag, tostring(Selected))
                Funcs:FireCallback(Callback, Selected)
            end

            local function UpdateLabel()
                local plr = Players:FindFirstChild(tostring(Selected))
                if plr then
                    ActiveLabel.Text = plr.DisplayName
                    UpdateHeaderAvatar(plr)
                else
                    ActiveLabel.Text = tostring(Selected or "...")
                    UpdateHeaderAvatar(nil)
                end
            end

            local function UpdateSelected()
                for _, v in pairs(Options) do
                    local Slt = v.Value == Selected
                    local nodes = v.nodes
                    if nodes[2] then
                        CreateTween({nodes[2], "BackgroundTransparency", Slt and 0 or 1, 0.35})
                        CreateTween({nodes[2], "Size", Slt and UDim2.fromOffset(4, 26) or UDim2.fromOffset(4, 4), 0.35})
                        CreateTween({nodes[3], "TextTransparency", Slt and 0 or 0.2, 0.35})
                        CreateTween({nodes[4], "TextTransparency", Slt and 0.2 or 0.5, 0.35})
                    end
                end
                UpdateLabel()
            end

            local function ScrollToSelected()
                if not Selected or Selected == "..." then return end
                for _, opt in pairs(Options) do
                    if opt.Value == Selected and opt.nodes[1] then
                        local btn = opt.nodes[1]
                        task.defer(function()
                            local yPos = btn.AbsolutePosition.Y - ScrollFrame.AbsolutePosition.Y + ScrollFrame.CanvasPosition.Y
                            ScrollFrame.CanvasPosition = Vector2.new(0, math.max(0, yPos - 5))
                        end)
                        break
                    end
                end
            end

            local function Select(Option)
                if #SearchTextBox.Text > 0 then wasSearching = true end

                Option.LastCB = tick()
                Selected = Option.Value
                CallbackSelected()
                UpdateSelected()

                if not suppressInitialNotify then
                    local plr = Players:FindFirstChild(Selected)
                    if plr then SendPlayerNotification(plr, "Player Selecionado:") end
                end
            end

            local function AddOption(plr)
                local Name = plr.Name
                if Options[Name] then return end

                local isFriend = false
                pcall(function()
                    isFriend = LocalPlayer:IsFriendsWith(plr.UserId)
                end)

                local displayName = plr.DisplayName
                if isFriend then displayName = displayName .. " -AMG" end

                Options[Name] = {
                    Value = Name,
                    Name = Name,
                    DisplayName = displayName,
                    IsFriend = isFriend,
                    nodes = {}
                }

                local OptButton = Make("Button", ScrollFrame, {
                    Name = "Option",
                    Size = UDim2.new(1, 0, 0, OPTION_HEIGHT),
                    LayoutOrder = isFriend and 1 or 2
                })
                Make("Corner", OptButton, UDim.new(0, 5))

                local IsSelected = InsertTheme(Create("Frame", OptButton, {
                    Position = UDim2.new(0, 2, 0.5),
                    Size = UDim2.new(0, 4, 0, 4),
                    BackgroundColor3 = Theme["Color Theme"],
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(0, 0.5)
                }), "Theme")
                Make("Corner", IsSelected, UDim.new(0.5, 0))

                local PlayerIcon = Create("ImageLabel", OptButton, {
                    Size = UDim2.fromOffset(30, 30),
                    Position = UDim2.new(0, 10, 0.5),
                    AnchorPoint = Vector2.new(0, 0.5),
                    BackgroundTransparency = 1,
                    Image = ""
                })
                Make("Corner", PlayerIcon, UDim.new(0.5, 0))

                task.spawn(function()
                    pcall(function()
                        local content, isReady = Players:GetUserThumbnailAsync(
                            plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                        if isReady then PlayerIcon.Image = content end
                    end)
                end)

                local DisplayLabel = InsertTheme(Create("TextLabel", OptButton, {
                    Size = UDim2.new(1, -54, 0, 16),
                    Position = UDim2.new(0, 46, 0, 5),
                    Text = displayName,
                    TextColor3 = Theme["Color Text"],
                    Font = MyLibrary.CurrentFont,
                    TextSize = 13,
                    TextXAlignment = "Left",
                    BackgroundTransparency = 1,
                    TextTransparency = 0.2,
                    TextTruncate = "AtEnd"
                }), "Text")

                local UserLabel = InsertTheme(Create("TextLabel", OptButton, {
                    Size = UDim2.new(1, -54, 0, 12),
                    Position = UDim2.new(0, 46, 0, 22),
                    Text = "@" .. Name,
                    TextColor3 = Theme["Color Dark Text"],
                    Font = MyLibrary.CurrentFont,
                    TextSize = 11,
                    TextXAlignment = "Left",
                    BackgroundTransparency = 1,
                    TextTransparency = 0.5,
                    TextTruncate = "AtEnd"
                }), "SubText")

                OptButton.Activated:Connect(function()
                    if Options[Name] then Select(Options[Name]) end
                end)

                Options[Name].nodes = {OptButton, IsSelected, DisplayLabel, UserLabel}
            end

            local function RemoveOption(Name)
                local opt = Options[Name]
                if opt then
                    if opt.nodes[1] then opt.nodes[1]:Destroy() end
                    Options[Name] = nil
                end
            end

            local function RefreshPlayers()
                if CustomOptions and type(CustomOptions) == "table" then
                    local toRemove = {}
                    for name in pairs(Options) do
                        if not table.find(CustomOptions, name) then table.insert(toRemove, name) end
                    end
                    for _, name in ipairs(toRemove) do RemoveOption(name) end

                    for _, name in ipairs(CustomOptions) do
                        local plr = Players:FindFirstChild(name)
                        if plr and plr ~= LocalPlayer then AddOption(plr) end
                    end
                else
                    local toRemove = {}
                    for name in pairs(Options) do
                        if not Players:FindFirstChild(name) then table.insert(toRemove, name) end
                    end
                    for _, name in ipairs(toRemove) do RemoveOption(name) end

                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer then AddOption(plr) end
                    end
                end

                if not hasAutoSelected then
                    hasAutoSelected = true

                    if autoSelectEnabled then
                        local firstOption, firstFriend = nil, nil
                        for _, opt in pairs(Options) do
                            if opt.IsFriend and not firstFriend then
                                firstFriend = opt
                            elseif not firstOption then
                                firstOption = opt
                            end
                        end

                        local autoTarget = firstFriend or firstOption
                        if autoTarget then
                            Selected = autoTarget.Value
                            CallbackSelected()
                        else
                            Selected = "..."
                        end
                    else
                        Selected = OpDefault
                    end
                elseif Selected and Selected ~= "..." then
                    if not Options[Selected] or not Players:FindFirstChild(Selected) then
                        Selected = "..."
                        CallbackSelected()
                    end
                end

                UpdateSelected()
                CalculateSize(false)
            end

            -- clique no personagem para selecionar
            local cClick = Track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed or not clickToSelectEnabled or not ClickToggleActive then return end

                if IsPress(input) then
                    local target = LocalPlayer:GetMouse().Target
                    if target then
                        local characterModel = target:FindFirstAncestorOfClass("Model")
                        if characterModel then
                            local playerFound = Players:GetPlayerFromCharacter(characterModel)
                            if playerFound and playerFound ~= LocalPlayer then
                                if Options[playerFound.Name] then
                                    Select(Options[playerFound.Name])
                                else
                                    Selected = playerFound.Name
                                    CallbackSelected()
                                    UpdateSelected()
                                    SendPlayerNotification(playerFound, "Player Selecionado:")
                                end
                            end
                        end
                    end
                end
            end))

            SearchTextBox:GetPropertyChangedSignal("Text"):Connect(function()
                local query = string.lower(SearchTextBox.Text)
                for _, item in pairs(Options) do
                    local matchDisplay = string.find(string.lower(item.DisplayName), query, 1, true)
                    local matchUser = string.find(string.lower(item.Name), query, 1, true)
                    item.nodes[1].Visible = query == "" or matchDisplay ~= nil or matchUser ~= nil
                end
                CalculateSize(true)
            end)

            local function Close()
                if Busy or not NoClickFrame.Visible then return end
                Busy = true
                Arrow.Image = ARROW_DOWN
                CreateTween({Arrow, "ImageColor3", Color3.fromRGB(255, 255, 255), 0.2})
                CreateTween({DropFrame, "Size", UDim2.new(0, DROPDOWN_WIDTH, 0, 0), 0.2, true})
                NoClickFrame.Visible = false
                Busy = false
            end

            local function ForceClose()
                NoClickFrame.Visible = false
                DropFrame.Size = UDim2.new(0, DROPDOWN_WIDTH, 0, 0)
                Arrow.Image = ARROW_DOWN
                Arrow.ImageColor3 = Color3.fromRGB(255, 255, 255)
            end

            local function Open()
                if Busy then return end
                SearchTextBox.Text = ""
                for _, item in pairs(Options) do item.nodes[1].Visible = true end
                NoClickFrame.Visible = true
                Arrow.Image = ARROW_UP
                CreateTween({Arrow, "ImageColor3", Theme["Color Theme"], 0.2})
                CalculateSize(false)
                CalculatePos()
                CreateTween({DropFrame, "Size", GetFrameSize(), 0.2})

                if wasSearching then
                    ScrollToSelected()
                    wasSearching = false
                end
            end

            Button.Activated:Connect(function()
                if NoClickFrame.Visible then Close() else Open() end
            end)
            NoClickFrame.MouseButton1Down:Connect(Close)
            MainFrame:GetPropertyChangedSignal("Visible"):Connect(ForceClose)
            SelectedFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
                if NoClickFrame.Visible then CalculatePos() end
            end)
            ScrollFrame.ChildAdded:Connect(function() CalculateSize(false) end)
            ScrollFrame.ChildRemoved:Connect(function() CalculateSize(false) end)

            local c1 = Players.PlayerAdded:Connect(function()
                task.wait(0.3)
                RefreshPlayers()
            end)

            local c2 = Players.PlayerRemoving:Connect(function(plr)
                RemoveOption(plr.Name)
                if Selected == plr.Name then
                    SendPlayerNotification(plr, "O Player Selecionado Saiu:")
                    Selected = "..."
                    CallbackSelected()
                end
                RefreshPlayers()
            end)
            Track(c1)
            Track(c2)

            RefreshPlayers()
            CalculatePos()
            suppressInitialNotify = false

            local Dropdown = {}
            Dropdown.ActiveLabel = ActiveLabel
            function Dropdown:Visible(...) Funcs:ToggleVisible(Button, ...) end
            function Dropdown:Destroy()
                c1:Disconnect()
                c2:Disconnect()
                cClick:Disconnect()
                NoClickFrame:Destroy()
                Button:Destroy()
            end
            function Dropdown:Get() return Selected end
            function Dropdown:Set(Val1)
                if type(Val1) == "string" then
                    Selected = Val1
                    UpdateSelected()
                end
            end
            function Dropdown:Refresh(newOptions)
                if type(newOptions) == "table" then
                    CustomOptions = newOptions
                end
                RefreshPlayers()
            end

            return Dropdown
        end

