local SetProps, SetChildren, InsertTheme, Create do
    InsertTheme = function(Inst, Type)
        table.insert(MyLibrary.Instances, {
            Instance = Inst,
            Type = Type
        })
        return Inst
    end

    SetChildren = function(Inst, Children)
        if Children then
            for _, Child in pairs(Children) do
                Child.Parent = Inst
            end
        end
        return Inst
    end

    SetProps = function(Inst, Props)
        if Props then
            for prop, value in pairs(Props) do
                Inst[prop] = value
            end
        end
        return Inst
    end

    Create = function(...)
        local args = {...}
        local new = Instance.new(args[1])

        if type(args[2]) == "table" then
            SetProps(new, args[2])
            SetChildren(new, args[3])
        elseif typeof(args[2]) == "Instance" then
            new.Parent = args[2]
            SetProps(new, args[3])
            SetChildren(new, args[4])
        end
        return new
    end
end

local function Color3ToHex(c)
    return string.format("#%02X%02X%02X", math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
end

local function HexToColor3(hex)
    hex = tostring(hex):gsub("#", "")
    local r = tonumber(hex:sub(1, 2), 16) or 0
    local g = tonumber(hex:sub(3, 4), 16) or 0
    local b = tonumber(hex:sub(5, 6), 16) or 0
    return Color3.fromRGB(r, g, b)
end

local function SerializeThemeValue(v)
    if typeof(v) == "Color3" then
        return { T = "Color3", C = Color3ToHex(v) }
    elseif typeof(v) == "ColorSequence" then
        local kps = {}
        for _, kp in ipairs(v.Keypoints) do
            table.insert(kps, { Time = kp.Time, C = Color3ToHex(kp.Value) })
        end
        return { T = "ColorSequence", K = kps }
    end
end

local function DeserializeThemeValue(data)
    if type(data) ~= "table" then return nil end
    if data.T == "Color3" and data.C then
        return HexToColor3(data.C)
    elseif data.T == "ColorSequence" and type(data.K) == "table" then
        local kps = {}
        for _, kp in ipairs(data.K) do
            table.insert(kps, ColorSequenceKeypoint.new(kp.Time, HexToColor3(kp.C)))
        end
        if #kps >= 2 then
            return ColorSequence.new(kps)
        end
    end
end

