    function Window:MakeSecondaryTab(Cfg)
        local TName = Cfg[1] or Cfg.Title or "Tab"

        local TabSelect = Make("Button", SecondaryTabContainer, {
            Size = UDim2.new(0, 75, 0, 22)
        })
        Make("Corner", TabSelect, UDim.new(0, 4))

        local SelectionIndicator = InsertTheme(Create("Frame", TabSelect, {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Theme["Color Theme"],
            Visible = false,
            Name = "SelectionIndicator",
            ZIndex = 1
        }), "Theme")
        Make("Corner", SelectionIndicator, UDim.new(0, 4))

        local LabelTitle = InsertTheme(Create("TextLabel", TabSelect, {
            Size = UDim2.new(1, -10, 1),
            Position = UDim2.new(0, 5, 0),
            BackgroundTransparency = 1,
            Font = MyLibrary.CurrentFont,
            Text = TName,
            TextColor3 = Theme["Color Text"],
            TextSize = 9,
            TextXAlignment = "Left",
            TextTruncate = "AtEnd",
            ZIndex = 2
        }), "Text")

        local Container = InsertTheme(Create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            ScrollBarThickness = 1.5,
            BackgroundTransparency = 1,
            ScrollBarImageTransparency = 0.2,
            ScrollBarImageColor3 = Theme["Color Theme"],
            AutomaticCanvasSize = "Y",
            ScrollingDirection = "Y",
            BorderSizePixel = 0,
            CanvasSize = UDim2.new(),
            Name = ("SecondaryContainer %i [ %s ]"):format(#SecondaryContainerList + 1, TName)
        }, {
            Create("UIPadding", {
                PaddingLeft = UDim.new(0, 10),
                PaddingRight = UDim.new(0, 10),
                PaddingTop = UDim.new(0, 10),
                PaddingBottom = UDim.new(0, 10)
            }),
            Create("UIListLayout", { Padding = UDim.new(0, 5) })
        }), "ScrollBar")

        table.insert(SecondaryContainerList, Container)
        if not SecondaryFirstTab then
            Container.Parent = SecondaryContainers
            SelectionIndicator.Visible = true
        end
        SecondaryFirstTab = true

        local function Tabs()
            if Container.Parent then return end

            for _, Frame in ipairs(SecondaryContainerList) do
                if Frame ~= Container then
                    Frame.Parent = nil
                end
            end

            Container.Parent = SecondaryContainers
            Container.Size = UDim2.new(1, 0, 1, 150)
            CreateTween({Container, "Size", UDim2.new(1, 0, 1, 0), 0.3})

            for _, tabData in ipairs(SecondaryTabs) do
                tabData.indicator.Visible = (tabData.Cont == Container)
            end
        end
        TabSelect.Activated:Connect(Tabs)

        local Tab = {}
        Tab.Cont = Container
        Tab.indicator = SelectionIndicator

        table.insert(SecondaryTabs, {
            func = Tab,
            Cont = Container,
            tabButton = TabSelect,
            indicator = SelectionIndicator
        })

        function Tab:Disable()
            Container.Parent = nil
            SelectionIndicator.Visible = false
        end
        function Tab:Enable() Tabs() end
        function Tab:Visible(Bool)
            Funcs:ToggleVisible(TabSelect, Bool)
            if Bool == false then Container.Parent = nil end
        end
        function Tab:Destroy()
            TabSelect:Destroy()
            Container:Destroy()
        end
        function Tab:SetTitle(NewTitle) LabelTitle.Text = NewTitle end

        AttachElements(Tab, Container, StackedCtx)
        return Tab
    end

