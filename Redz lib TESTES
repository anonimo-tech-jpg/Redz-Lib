            local ARROW_DOWN, ARROW_UP = "rbxassetid://10709791523", "rbxassetid://10709790948"
            local Arrow = Create("ImageLabel", SelectedFrame, {
                Size = UDim2.new(0, 15, 0, 15),
                Position = UDim2.new(1, -5, 0.5),
                AnchorPoint = Vector2.new(1, 0.5),
                Image = ARROW_DOWN,
                BackgroundTransparency = 1
            })

            -- mini toggle "Click Player"
            local ClickToggleActive = false

            local ClickPlayerFrame = Create("TextButton", Button, {
                Size = UDim2.new(0, 150, 0, 14),
                Position = UDim2.new(1, -10, 0, 29),
                AnchorPoint = Vector2.new(1, 0),
                BackgroundTransparency = 1,
                Text = "",
